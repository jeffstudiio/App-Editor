# نمونهٔ متغیرهای محیطی — کپی کن به .env.local و مقدار بده
DATABASE_URL=file:./db/custom.db

# ── AI Providers (همه اختیاری؛ اپ بدون آن‌ها هم کار می‌کند) ──
GEMINI_API_KEY=        # Google Gemini — متن/تصویر (fallback سمت سرور)
GROQ_API_KEY=          # Groq — متن سریع (free-tier)
HUGGINGFACE_API_KEY=   # Hugging Face — متن/ترجمه/امبدینگ متن‌باز
JINA_API_KEY=          # Jina — امبدینگ عصبی برای جست‌وجوی معنایی
OPENROUTER_API_KEY=    # OpenRouter — fallback سرور (کلید BYO کاربر ترجیح دارد)
